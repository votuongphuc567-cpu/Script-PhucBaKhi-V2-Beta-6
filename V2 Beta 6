local auraObjects = {}
local auraConnection

local function removePlayerAura()
    if auraConnection then
        auraConnection:Disconnect()
        auraConnection = nil
    end
    for _, obj in ipairs(auraObjects) do
        if obj and obj.Parent then obj:Destroy() end
    end
    table.clear(auraObjects)
end

local function setPlayerAura(enabled)
    S.playerAura = enabled
    removePlayerAura()

    if not enabled or not character or not root then return end

    local h = Instance.new("Highlight")
    h.Name = "BKP_PlayerAura"
    h.Adornee = character
    h.FillColor = green
    h.OutlineColor = Color3.fromRGB(170, 255, 185)
    h.FillTransparency = 0.86
    h.OutlineTransparency = 0.1
    h.Parent = character
    table.insert(auraObjects, h)

    local attachment = Instance.new("Attachment")
    attachment.Name = "BKP_AuraAttachment"
    attachment.Parent = root
    table.insert(auraObjects, attachment)

    local emitter = Instance.new("ParticleEmitter")
    emitter.Name = "BKP_GreenAura"
    emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    emitter.Color = ColorSequence.new(green, Color3.fromRGB(15, 180, 65))
    emitter.LightEmission = 0.8
    emitter.Rate = 18
    emitter.Lifetime = NumberRange.new(0.5, 1)
    emitter.Speed = NumberRange.new(0.5, 2)
    emitter.SpreadAngle = Vector2.new(180, 180)
    emitter.Rotation = NumberRange.new(0, 360)
    emitter.RotSpeed = NumberRange.new(-100, 100)
    emitter.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.12),
        NumberSequenceKeypoint.new(0.5, 0.3),
        NumberSequenceKeypoint.new(1, 0)
    })
    emitter.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.1),
        NumberSequenceKeypoint.new(1, 1)
    })
    emitter.Parent = attachment
    table.insert(auraObjects, emitter)

    local light = Instance.new("PointLight")
    light.Name = "BKP_AuraLight"
    light.Color = green
    light.Brightness = 0.8
    light.Range = 8
    light.Parent = root
    table.insert(auraObjects, light)

    local elapsed = 0
    auraConnection = RS.Heartbeat:Connect(function(dt)
        if not S.playerAura or not h.Parent then return end
        elapsed += dt
        local wave = (math.sin(elapsed * 3) + 1) / 2
        h.OutlineColor = Color3.fromRGB(70 + math.floor(wave * 100), 255, 100)
        light.Brightness = 0.5 + wave
    end)
end

