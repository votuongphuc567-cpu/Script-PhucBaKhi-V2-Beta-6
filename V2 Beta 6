local function addTab(name, callback)
    local b = create("TextButton", {
        Size = UDim2.new(1/3, -4, 1, 0),
        BackgroundColor3 = Color3.fromRGB(38, 43, 41),
        Text = name,
        TextColor3 = Color3.new(1, 1, 1),
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false
    }, tabs)
    round(b, 11)
    table.insert(tabButtons, b)

    b.Activated:Connect(function()
        for _, tab in ipairs(tabButtons) do
            tween(tab, 0.16, {
                BackgroundColor3 = tab == b
                    and theme
                    or Color3.fromRGB(38, 43, 41)
            })
        end
        callback()
    end)
end

local function toggleRow(title, key, onChange)
    local b = makeButton(
        content,
        title .. ": " .. (S[key] and "ON" or "OFF"),
        39
    )

    b.Activated:Connect(function()
        local newValue = not S[key]

        if key == "luckyAura" then
            setLuckyAura(newValue)
        elseif key == "playerAura" then
            setPlayerAura(newValue)
        else
            S[key] = newValue
        end

        if onChange then onChange(newValue) end

        b.Text = title .. ": " .. (newValue and "ON" or "OFF")
        b.BackgroundColor3 = newValue
            and Color3.fromRGB(28, 95, 51)
            or Color3.fromRGB(37, 41, 43)
    end)

    return b
end

local function numericSetting(title, currentValue, minValue, maxValue, apply)
    label(title .. " hiện tại: " .. currentValue, 25)

    local row = create("Frame", {
        Size = UDim2.new(1, 0, 0, 39),
        BackgroundTransparency = 1
    }, content)

    create("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 6)
    }, row)

    local input = create("TextBox", {
        Size = UDim2.new(0.65, -3, 1, 0),
        BackgroundColor3 = Color3.fromRGB(37, 41, 43),
        Text = tostring(currentValue),
        PlaceholderText = "Nhập số...",
        TextColor3 = Color3.new(1, 1, 1),
        TextSize = 14,
        Font = Enum.Font.Gotham,
        ClearTextOnFocus = false
    }, row)
    round(input, 10)

    local applyButton = create("TextButton", {
        Size = UDim2.new(0.35, -3, 1, 0),
        BackgroundColor3 = theme,
        Text = "APPLY",
        TextColor3 = Color3.new(1, 1, 1),
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false
    }, row)
    round(applyButton, 10)

    applyButton.Activated:Connect(function()
        local value = tonumber(input.Text)
        if not value or value ~= value then
            input.Text = tostring(currentValue)
            return
        end

        value = math.clamp(math.floor(value), minValue, maxValue)
        input.Text = tostring(value)
        apply(value)
    end)
end

