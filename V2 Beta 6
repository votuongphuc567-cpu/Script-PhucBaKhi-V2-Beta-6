local function create(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end

local function round(obj, radius)
    create("UICorner", {
        CornerRadius = UDim.new(0, radius or 10)
    }, obj)
end

local function stroke(obj, color, thickness, transparency)
    return create("UIStroke", {
        Color = color or theme,
        Thickness = thickness or 1,
        Transparency = transparency or 0
    }, obj)
end

local function tween(obj, duration, props, style, direction)
    local t = TS:Create(obj, TweenInfo.new(
        duration,
        style or Enum.EasingStyle.Quint,
        direction or Enum.EasingDirection.Out
    ), props)
    t:Play()
    return t
end

local function makeButton(parent, text, height)
    local b = create("TextButton", {
        Size = UDim2.new(1, 0, 0, height or 38),
        BackgroundColor3 = Color3.fromRGB(37, 41, 43),
        BackgroundTransparency = 0.08,
        Text = text,
        TextColor3 = Color3.fromRGB(245, 248, 246),
        TextSize = 13,
        Font = Enum.Font.GothamMedium,
        AutoButtonColor = false,
        BorderSizePixel = 0
    }, parent)

    round(b, 11)
    local edge = stroke(b, Color3.fromRGB(130, 145, 135), 1, 0.75)

    b.Activated:Connect(function()
        tween(b, 0.08, {BackgroundTransparency = 0.28})
        task.delay(0.1, function()
            if b.Parent then
                tween(b, 0.18, {BackgroundTransparency = 0.08})
            end
        end)
    end)

    b.MouseEnter:Connect(function()
        tween(edge, 0.15, {Transparency = 0.25})
    end)
    b.MouseLeave:Connect(function()
        tween(edge, 0.15, {Transparency = 0.75})
    end)

    return b
end

