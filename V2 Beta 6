local function optimizeGraphics(enabled)
    S.optimize = enabled

    if enabled then
        table.clear(savedGraphics)

        local function saveProperty(obj, property, newValue)
            local ok, oldValue = pcall(function()
                return obj[property]
            end)
            if not ok then return end

            table.insert(savedGraphics, {
                obj = obj,
                property = property,
                value = oldValue
            })

            pcall(function()
                obj[property] = newValue
            end)
        end

        saveProperty(Lighting, "GlobalShadows", false)

        for _, obj in ipairs(Lighting:GetDescendants()) do
            if obj:IsA("PostEffect") then
                saveProperty(obj, "Enabled", false)
            end
        end

        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ParticleEmitter")
                or obj:IsA("Trail")
                or obj:IsA("Beam")
                or obj:IsA("Fire")
                or obj:IsA("Smoke")
                or obj:IsA("Sparkles") then
                saveProperty(obj, "Enabled", false)
            end
        end
    else
        for _, entry in ipairs(savedGraphics) do
            if entry.obj and entry.obj.Parent then
                pcall(function()
                    entry.obj[entry.property] = entry.value
                end)
            end
        end
        table.clear(savedGraphics)
    end
end

