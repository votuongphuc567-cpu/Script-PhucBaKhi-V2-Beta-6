    ringAngle = (ringAngle + dt * 100) % 360
    pulse += dt * 3

    if S.rgb then
        local c = Color3.fromHSV(hue, 0.8, 1)
        header.BackgroundColor3 = c
        bubble.BackgroundColor3 = c
    end

    if S.luckyAura then
        local wave = (math.sin(pulse) + 1) / 2

        ring1.Rotation = ringAngle
        ring2.Rotation = -ringAngle * 1.35
        ringStroke1.Thickness = 1.3 + wave * 2
        ringStroke1.Transparency = 0.05 + wave * 0.3
        ringStroke2.Transparency = 0.05 + wave * 0.4

        luckyTitle.TextColor3 = Color3.fromRGB(
            100 + math.floor(wave * 80),
            255,
            120 + math.floor(wave * 80)
        )

        luckyStroke.Thickness = 1.5 + wave * 1.5

        for i, spark in ipairs(sparks) do
            local angle = math.rad(
                ringAngle * (i % 2 == 0 and 1 or -1) + i * 45
            )
            local radius = 0.35 + wave * 0.08

            spark.Position = UDim2.new(
                0.5 + math.cos(angle) * radius, 0,
                0.5 + math.sin(angle) * radius, 0
            )
            spark.TextTransparency = 0.05 + wave * 0.55
            spark.Rotation = ringAngle * (i % 2 == 0 and 1 or -1)
        end
    end

    if S.fly and root and humanoid and flyVelocity and flyGyro then
        local camera = workspace.CurrentCamera
        local direction = humanoid.MoveDirection
        local vertical = (flyUp and 1 or 0) - (flyDown and 1 or 0)

        flyVelocity.Velocity =
            direction * S.flySpeed
            + Vector3.new(0, vertical * S.flySpeed, 0)

        if camera then flyGyro.CFrame = camera.CFrame end
    end
end)

